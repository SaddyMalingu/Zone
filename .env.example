# Zone — Environment Variables
# Copy this file to .env.local and fill in your API keys.
# Never commit .env.local to version control.

# ─────────────────────────────────────────
# AI PROVIDERS
# ─────────────────────────────────────────

# Hugging Face — https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_REPLACE_ME

# Replicate — https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_REPLACE_ME

# Optional: OpenAI (for prompt augmentation / future use)
# OPENAI_API_KEY=sk-REPLACE_ME

# ─────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────

# SQLite (default, no setup needed)
DATABASE_URL="file:./zone.db"

# PostgreSQL (uncomment and replace for production)
# DATABASE_URL="postgresql://user:password@localhost:5432/zone"

# ─────────────────────────────────────────
# GENERATION ENGINE
# ─────────────────────────────────────────

# How often content is generated (in milliseconds). Default: 30000 (30s)
GENERATION_INTERVAL_MS=30000

# Maximum concurrent generation jobs
MAX_CONCURRENT_JOBS=3

# Default content type: "image" | "video" | "both"
DEFAULT_CONTENT_TYPE=image

# ─────────────────────────────────────────
# REDIS (for BullMQ job queue — optional in dev)
# ─────────────────────────────────────────
# REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────
# APP
# ─────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Zone
NEXT_PUBLIC_APP_URL=http://localhost:3000
